#!/usr/bin/env python3
"""voice: the suite command's catalogue held to its voice (packet ak1a R5).

Usage: voice [--check] [--catalogue FILE] [--config FILE] [--sidecar FILE]

With no --check (`make voice`) it runs respeak's scanner,
`respeak-measure.py <catalogue> --config <config> --fail-on warn`, and on its exit 0 writes the
sidecar: one `shasum -a 256` line for the catalogue, its path from the repo root. The scanner is
found by RESPEAK_ROOT (`$RESPEAK_ROOT/scripts/respeak-measure.py`), else under the root of the
respeak plugin that stands, as the suite's finder says (`agentik_suite.sources`, row fk1-sources:
the user file's `sources.respeak`, else the one installed copy of the user's own), never by a
sibling checkout's path or a cache folder no entry names. It runs under this interpreter when that
one imports yaml, else under /usr/bin/python3. With no scanner (respeak undecided, absent or not
found) it exits 2 and writes nothing; on the scanner's failure it exits 1 and writes nothing.

With --check (`make check`, stdlib, no scanner) it compares the catalogue with the sidecar's line:
exit 0 when they agree, 1 when they differ or the sidecar is absent, one stderr line naming
`make voice`.
"""
import hashlib
import importlib.util
import os
import subprocess
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CATALOGUE = "plugins/suite/lib/agentik_suite/messages.md"
CONFIG = "design/voice/budgets.yaml"
SIDECAR = "design/voice/checked.sha256"
SCANNER = os.path.join("scripts", "respeak-measure.py")
USAGE = "usage: voice [--check] [--catalogue FILE] [--config FILE] [--sidecar FILE]"


def line_for(path):
    with open(os.path.join(REPO, path), "rb") as fh:
        return "%s  %s\n" % (hashlib.sha256(fh.read()).hexdigest(), path)


def scanner(env):
    """(path, None) for the scanner, or (None, why) when there is none."""
    root = env.get("RESPEAK_ROOT")
    if root:
        path = os.path.join(root, SCANNER)
        return (path, None) if os.path.isfile(path) else (None, "RESPEAK_ROOT holds no %s" % SCANNER)
    sys.path.insert(0, os.path.join(REPO, "plugins", "suite", "lib"))
    from agentik_suite import settings, sources
    try:
        cwd = os.getcwd()
    except OSError:
        cwd = None
    try:
        row = sources.read(env, cwd, ["respeak"], more=False)[0]
    except settings.Fault as f:
        return None, "the suite's user file, line %d: %s" % (f.line, f.why)
    if not row["found"]:
        return None, "sources says respeak is %s" % (row["kind"] if row["kind"] in ("undecided", "absent")
                                                     else "not found")
    path = os.path.join(row["root"], SCANNER)
    return (path, None) if os.path.isfile(path) else (None, "sources' respeak holds no %s" % SCANNER)


def interpreter():
    if importlib.util.find_spec("yaml") is not None:
        return sys.executable
    return "/usr/bin/python3"


def main(argv):
    opts = {"--catalogue": CATALOGUE, "--config": CONFIG, "--sidecar": SIDECAR}
    check, args = False, list(argv)
    while args:
        arg = args.pop(0)
        if arg == "--check":
            check = True
        elif arg in opts and args:
            opts[arg] = args.pop(0)
        else:
            print(USAGE, file=sys.stderr)
            return 2
    catalogue, sidecar = opts["--catalogue"], os.path.join(REPO, opts["--sidecar"])
    if check:
        try:
            with open(sidecar, encoding="utf-8") as fh:
                held = fh.read()
        except OSError:
            held = None
        if held != line_for(catalogue):
            print("voice: %s differs from the line in %s; run make voice" % (catalogue, opts["--sidecar"]),
                  file=sys.stderr)
            return 1
        print("voice: %s as checked" % catalogue)
        return 0
    found, why = scanner(os.environ)
    if not found:
        print("voice: no scanner (%s): set RESPEAK_ROOT, or install one respeak plugin; nothing written"
              % why, file=sys.stderr)
        return 2
    rc = subprocess.call([interpreter(), found, os.path.join(REPO, catalogue),
                          "--config", os.path.join(REPO, opts["--config"]), "--fail-on", "warn"])
    if rc != 0:
        print("voice: the scanner exited %d; nothing written" % rc, file=sys.stderr)
        return 1
    tmp = sidecar + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(line_for(catalogue))
    os.replace(tmp, sidecar)
    print("voice: %s checked; %s written" % (catalogue, opts["--sidecar"]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
