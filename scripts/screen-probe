#!/usr/bin/python3
"""screen-probe: every screen of the suite's command, rendered four ways and held to five checks.

Usage: screen-probe [--root DIR] [--only NAME,...] [--wall S] [--keep]

--only names screens of SCREENS, or `catalogue` for the catalogue's check alone.

Row sc0-screen-probe (design/23 sections 3 to 9). Under a fresh temp dir T it builds the homes of
SCREENS' table, each a HOME with a stub `claude` and made-up tools, and renders each screen of the
table there four ways: on a pty at 80 columns, on a pty at 50, in a pipe, and on a pty at 80 under
NO_COLOR=1. The suite is the one under DIR (--root, else this checkout): its launcher by the path
typed, or the door `agentik` that an applied setup placed. Then five checks, each a function a test
calls alone:

  1. width: no line of a pty run past its columns, but a lone path or command (`lone`); a pipe's
     row is one line and takes no width check;
  2. name: no line of a screen run through the door holds `agentik-suite`, but a path ending in it;
  3. V9, read from the catalogue and never from a screen: no message holds a word that opens with
     `exit` (`exits`, `exited`, `exiting`) or a placeholder of a code (`{exit}`, `{code}`,
     `{exit_code}`, `{rc}`, `{returncode}`, `{status_code}`), but the ids of V9_LIST, each with
     its reason;
  4. budget: each screen's line count on a pty at 80 is at most BUDGET's number for it;
  5. paste: each `next:`, `check` and `undo` command of each screen, run by `sh -c` in that
     screen's home with stdin at /dev/null, exits neither 127 nor past the wall (--wall, 20 s).

A failure on KNOWN's list prints as `note` and keeps the probe at go; the coordinator rules each.
Nothing is written outside T, no real `claude` starts, and no child outlives the probe: each runs
in a process group of its own, stopped when it returns. On SIGTERM or SIGINT the probe stops its
children, removes T, prints `screen-probe: stop: <signal>` and exits 128 plus the signal's number.
T is removed unless --keep.

Output: one line per check, `ok`, `FAIL` or `note`, and last `screen-probe: go` or
`screen-probe: stop: <n> failed`. Exit 0 go, 1 a check failed, 2 usage. Stdlib only.
"""
import fcntl
import os
import re
import select
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import termios
import time
import unicodedata
from pathlib import Path

USAGE = "usage: screen-probe [--root DIR] [--only NAME,...] [--wall S] [--keep]"
HERE = Path(__file__).resolve().parents[1]
SYSTEM = "/usr/bin:/bin"
WAYS = ("pty80", "pty50", "pipe", "nocolor")
WALL = 20.0
FAILS = []
LIVE = set()  # each child started and not yet stopped, for a stop from outside (review 1 L5)

# V9's list: the pin's ids (main 6c60098) that hold the word or a code, each with its reason in a
# word. `flag`: a flag's help says the code a script reads. `owed`: a later row rewrites it.
V9_LIST = {
    "flag.config_pick": "flag",
    "flag.check": "flag",
    "flag.exit": "flag",
    "err.update.step": "owed",
    "err.update.step.silent": "owed",
    "err.update.todo": "owed",
    "remove.market.stands": "owed",
    "err.remove.step": "owed",
    "err.remove.step.silent": "owed",
    "inbox.read.no_answer": "owed",
    "err.issue.send.failed": "owed",
    "err.issue.exit": "owed",
    "issue.render.exit": "owed",
}

# KNOWN: what is red on the pin's screens (main 6c60098), by "<check>:<screen>": a pattern that
# each excused line matches, and the finding in a few words with the row that owes it. A line it
# matches prints as `note` and keeps the probe at go; any other red line of the screen is a FAIL;
# an entry with no red line left prints a note to take it off. Ruled by review 1 of sc0: each
# entry stays until sc17-narrow-screens mends it; the `usage:` line is a head over a command.
OWED = "; owed by sc17-narrow-screens"
KNOWN = {
    "width:err-uninstalled": (r"^(pty80|pty50|nocolor) line 1 .*relay has no command here yet",
                              "the refusal is one line of 130 (design/23 section 7's row 2)" + OWED),
    "name:setup-door": (r"^(pty80|pty50|pipe|nocolor) line \d+: .*5 agentik +agentik-suite, agentik",
                        "step 5's row names the launcher it placed" + OWED),
    "budget:doctor-empty": (r"^9 lines, budget 8 ", "9 lines in an empty HOME, sc10's 8" + OWED),
}

# The budget: each screen's most lines on a pty at 80 columns, a command or path spilled onto its
# own line uncounted (`spill`, as sc8 counts its plan), with where the number comes from: a row of
# design/23 section 9 that gives it, else `measured` at the pin (main 6c60098).
BUDGET = {
    "bare-empty": (10, "sc5"), "bare-three": (10, "sc5"), "bare-off": (10, "sc5"),
    "bare-door": (10, "sc5"),
    "help": (18, "measured"), "help-door": (20, "measured"),
    "help-config": (14, "measured"), "help-config-door": (14, "measured"),
    "config": (6, "measured"), "config-door": (8, "measured"),
    "config-loom": (20, "sc6"), "config-card": (8, "measured"),
    "setup-plan": (14, "sc8: the plan's 13, then next:"),
    "setup-applied": (30, "sc8: 13, 8 commands, a tail of 8, one more"),
    "setup-second": (6, "measured"), "setup-door": (11, "measured"),
    "setup-no": (17, "measured"), "setup-blocked": (23, "measured"),
    "setup-failed": (24, "measured"),
    "doctor-empty": (8, "sc10"), "doctor-applied": (20, "measured"),
    "doctor-door": (14, "measured"),
    "err-typo": (2, "measured"), "err-uninstalled": (2, "measured"),
    "err-config-uninstalled": (2, "measured"), "err-tool-not-verb": (2, "measured"),
    "err-flag": (2, "measured"), "err-extra": (2, "measured"),
    "err-help-version": (2, "measured"), "err-typo-door": (2, "measured"),
    "err-case-door": (2, "measured"),
}

# ---- the stub `claude` and the made-up tools ------------------------------------------------

# claude, as far as setup's lines need it: marketplace add, plugin install, each plugin's launcher
# a copy of PLUGIN_BIN beside it; the second install fails, saying seven lines, while `fail-second`
# is in its folder. Any other argv says nothing and exits 2.
CLAUDE = r'''#!/usr/bin/python3
import json, os, shutil, sys
here = os.path.dirname(os.path.abspath(__file__))
d = os.path.join(os.environ["HOME"], ".claude", "plugins")
a = sys.argv[1:]
if a[:3] == ["plugin", "marketplace", "add"] and len(a) == 4:
    os.makedirs(d, exist_ok=True)
    json.dump({"agentik": {}}, open(os.path.join(d, "known_marketplaces.json"), "w"))
elif a[:2] == ["plugin", "install"] and len(a) == 3 and a[2].endswith("@agentik"):
    if not os.path.exists(os.path.join(d, "known_marketplaces.json")):
        sys.exit(1)
    count = os.path.join(here, "installs")
    n = (int(open(count).read()) if os.path.exists(count) else 0) + 1
    open(count, "w").write(str(n))
    if n == 2 and os.path.exists(os.path.join(here, "fail-second")):
        for i in range(1, 8):
            print("resolver line %d of the plugin, said whole" % i, flush=True)
        sys.exit(1)
    name = a[2].split("@")[0]
    root = os.path.join(d, "cache", "agentik", name, "1.0.0")
    os.makedirs(os.path.join(root, "bin"), exist_ok=True)
    shutil.copy(os.path.join(here, "plugin-bin"), os.path.join(root, "bin", "agentik-" + name))
    path = os.path.join(d, "installed_plugins.json")
    table = json.load(open(path)) if os.path.exists(path) else {"version": 2, "plugins": {}}
    table["plugins"][a[2]] = [{"scope": "user", "version": "1.0.0", "installPath": root}]
    json.dump(table, open(path, "w"))
else:
    sys.exit(2)
'''
# a plugin's launcher whose install-cli places its own command alone, so the door is the suite's
PLUGIN_BIN = """#!/bin/sh
case "$1" in
install-cli)
    exe="$HOME/.local/bin/$(basename "$0")"
    mkdir -p "$HOME/.local/bin" || exit 1
    printf '#!/bin/sh\\nVERSION=1.0.0\\nexec "%s" "$@"\\n' "$0" > "$exe" && chmod 755 "$exe" ;;
doctor) exit 0 ;;
*) exit 2 ;;
esac
"""
MURMUR = ('{"schema": "agentik.describe/1", "ok": true, "tool": "murmur", "version": "1.7.1", '
          '"summary": "Whisper each change to the log.", "repo": "example/murmur", '
          '"plugin": "murmur@agentik", "needs": [], "verbs": [], "reads": []}')
# loom, a made-up tool of 24 keys in five groups and three lone keys, four of them changed
LOOM_KEYS = ["mode", "speed", "voice", "ink.colour", "ink.weight", "ink.flow", "ink.dry",
             "page.width", "page.height", "page.margin", "page.gutter", "page.bleed",
             "spool.size", "spool.wind", "spool.tension", "spool.brake",
             "weave.warp", "weave.weft", "weave.twill", "weave.satin", "weave.plain",
             "weave.density", "feed.rate", "feed.pause"]
LOOM_FILE = "mode: fast\nink:\n  colour: black\n  weight: bold\npage:\n  width: 90\n"
LOOM = r'''#!/usr/bin/python3
import json, os, sys
home = os.environ["HOME"]
user = os.path.join(home, ".config", "loom", "config.yaml")
KEYS = %r
SET = {"mode": ("fast", user, 1), "ink.weight": ("bold", user, 4), "page.width": ("90", user, None)}
def s(key):
    value, path, line = SET.get(key, ("d-" + key, None, None))
    layer = "user" if path else "default"
    values = [{"layer": "default", "value": "d-" + key}]
    if path:
        values.append({"layer": "user", "value": value, "path": path, "line": line})
    return {"key": key, "value": value, "default": "d-" + key, "type": "string",
            "choices": ["fast", "slow"] if key == "mode" else None,
            "summary": "The %%s of the loom." %% key,
            "source": {"layer": layer, "path": path, "line": line},
            "change": {"kind": "command", "command": "agentik-loom set %%s <value>" %% key,
                       "path": None, "block": None, "note": None},
            "live": True, "values": values}
a = sys.argv[1:]
if a == ["describe", "--json"]:
    print(json.dumps({"schema": "agentik.describe/1", "ok": True, "tool": "loom", "version": "1.0.0",
        "summary": "A made-up tool.", "repo": "example/loom", "plugin": "loom@agentik", "needs": [],
        "verbs": [{"name": "set", "summary": "Set one.", "top": True}],
        "reads": [{"kind": "config", "name": "settings", "argv": ["describe", "config", "--json"]}]}))
elif a[:3] == ["describe", "config", "--json"]:
    rows = [s(k) for k in KEYS if not a[3:] or k == a[3]]
    print(json.dumps({"schema": "agentik.config/1", "ok": True, "tool": "loom", "settings": rows,
        "layers": [{"name": "default", "path": None, "present": True, "travels": False},
                   {"name": "user", "path": user, "present": True, "travels": True}],
        "warnings": []}))
elif a[:1] == ["doctor"]:
    sys.exit(0)
else:
    sys.exit(2)
''' % LOOM_KEYS


def say(kind, text):
    print("%-4s %s" % (kind, text), flush=True)
    if kind == "FAIL":
        FAILS.append(text)


def verdict(check, screen, bad, text, known=None):
    """One line for a check of a screen: ok, else FAIL naming its red lines, else `note` where
    each red line is one KNOWN rules, or where KNOWN rules a red that is gone (review 1 L10)."""
    known = KNOWN if known is None else known
    pattern, why = known.get("%s:%s" % (check, screen), (None, None))
    kept = [b for b in bad if pattern and re.search(pattern, b)]
    red = [b for b in bad if b not in kept]
    if red:
        say("FAIL", "%s: %s" % (text, "; ".join(red[:3])))
    elif kept:
        say("note", "known: %s: %s (%d lines)" % (text, why, len(kept)))
    elif pattern:
        say("note", "%s:%s is in KNOWN and red no more; take it off KNOWN" % (check, screen))
    else:
        say("ok", text)
    return red


def executable(path, body):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fh:
        fh.write(body)
    os.chmod(path, 0o755)
    return path


# ---- the homes ------------------------------------------------------------------------------

class Home:
    """A temp HOME: `stubs` (claude, the made-up tools), `work` (the folder each command runs
    in, no repository), and the env of exactly HOME, PATH, XDG_CACHE_HOME and TMPDIR, the last
    two inside the home, so a child writes nothing outside T."""

    def __init__(self, top, label, path=None):
        self.label = label
        self.home = os.path.join(top, label)
        self.stubs = os.path.join(self.home, "stubs")
        self.work = os.path.join(self.home, "work")
        self.bindir = os.path.join(self.home, ".local", "bin")
        self.path = path or "%s:%s" % (self.stubs, SYSTEM)
        os.makedirs(self.work, exist_ok=True)
        if not os.path.exists(os.path.join(self.stubs, "claude")):
            executable(os.path.join(self.stubs, "claude"), CLAUDE)
            executable(os.path.join(self.stubs, "plugin-bin"), PLUGIN_BIN)

    def env(self, **more):
        os.makedirs(os.path.join(self.home, ".tmp"), exist_ok=True)
        env = {"HOME": self.home, "PATH": self.path.replace("<bin>", self.bindir),
               "XDG_CACHE_HOME": os.path.join(self.home, ".cache"),
               "TMPDIR": os.path.join(self.home, ".tmp")}
        env.update(more)
        return env

    def copy(self, label):
        """A copy of this home, for a screen that writes in it."""
        other = os.path.join(os.path.dirname(self.home), label)
        shutil.copytree(self.home, other, symlinks=True)
        return Home(os.path.dirname(self.home), label, self.path)


def build_homes(top, launcher, labels=None):
    """The homes SCREENS names, by label; the two that run a setup only where `labels` holds one."""
    labels = {s[1] for s in SCREENS} if labels is None else set(labels)
    homes = {"empty": Home(top, "empty")}
    three = Home(top, "three")
    tools = os.path.join(three.home, "tools")
    three.path = "<bin>:%s:%s:%s" % (tools, three.stubs, SYSTEM)
    executable(os.path.join(tools, "agentik-murmur"),
               "#!/bin/sh\n[ \"$1\" = describe ] && cat <<'EOF'\n%s\nEOF\nexit 0\n" % MURMUR)
    executable(os.path.join(tools, "agentik-paint"), "#!/bin/sh\nexit 0\n")
    executable(os.path.join(tools, "agentik-quill"), "#!/bin/sh\nexit 0\n")
    homes["three"] = three
    loom = Home(top, "loom")
    os.makedirs(os.path.join(loom.home, ".config", "loom"))
    with open(os.path.join(loom.home, ".config", "loom", "config.yaml"), "w") as fh:
        fh.write(LOOM_FILE)
    executable(os.path.join(loom.stubs, "agentik-loom"), LOOM)
    homes["loom"] = loom
    blocked = Home(top, "blocked")
    os.remove(os.path.join(blocked.stubs, "claude"))
    homes["blocked"] = blocked
    failing = Home(top, "failing")
    open(os.path.join(failing.stubs, "fail-second"), "w").close()
    homes["failing"] = failing
    if not labels & {"applied-off", "applied-on", "three"}:
        return homes
    # an applied setup, then the same home with ~/.local/bin off PATH and on it (sc2's homes)
    applied = Home(top, "applied")
    code, _, err = run_child([launcher, "setup", "--yes"], applied.env(), applied.work, 300)
    if code != 0:
        say("FAIL", "the applied home: setup --yes gave %d: %s" % (code, last(err)))
    homes["applied-off"] = applied
    homes["applied-on"] = Home(top, "applied", "<bin>:%s:%s" % (applied.stubs, SYSTEM))
    homes["applied-on"].label = "applied-on"
    # three made-up tools beside the default set, the door placed (sc5's finished home)
    code, _, err = run_child([launcher, "setup", "--yes"], three.env(), three.work, 300)
    if code != 0:
        say("FAIL", "the home of three tools: setup --yes gave %d: %s" % (code, last(err)))
    return homes


