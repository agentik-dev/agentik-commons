def argv_of(how, home, words, launcher):
    return ([launcher] if how == "launcher" else [os.path.join(home.bindir, "agentik")]) + words


SGR = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b\][^\x07]*\x07|\r")


def lines_of(text):
    """A pipe's lines, any escape or carriage return dropped."""
    return [SGR.sub("", line) for line in text.replace("\r\n", "\n").split("\n")]


TOKEN = re.compile(r"\x1b\[([0-9;?<=>]*)[ -/]*([@-~])"     # a control sequence
                   r"|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)?"  # an operating system command
                   r"|\x1b[^\[\]]?"                        # any other escape
                   r"|([\r\n\b])|([^\x1b\r\n\b]+)")


def replay(text, cols, height=24):
    """The rows a terminal of `cols` columns and `height` rows shows once a pty's `text` is drawn
    (review 1 F2): a carriage return, erase line (`K`), erase down (`J`), the cursor's moves
    (`A`, `B`, `C`, `D`, `G`, `H`) and a clear of the window are applied, colour and the cursor's
    hide and show dropped. A line is never wrapped, so a row past `cols` stays one row for the
    width check to see; a line feed also returns the carriage, as a pty's onlcr does. Trailing
    blanks of a row and blank rows at the end are dropped."""
    rows, top, y, x = [[]], 0, 0, 0
    for m in TOKEN.finditer(text):
        params, final, ctl, chars = m.groups()
        while len(rows) <= y:
            rows.append([])
        row = rows[y]
        if chars is not None:
            if x > len(row):
                row.extend(" " * (x - len(row)))
            row[x:x + len(chars)] = list(chars)
            x += len(chars)
        elif ctl == "\r":
            x = 0
        elif ctl == "\n":
            y, x = y + 1, 0
            top = max(top, y - height + 1)
        elif ctl == "\b":
            x = max(0, x - 1)
        elif final and not params.startswith(("?", "<", "=", ">")):
            nums = [int(n) if n.isdigit() else 0 for n in params.split(";")]
            n = max(1, nums[0])
            if final == "A":
                y = max(top, y - n)
            elif final == "B":
                y = min(top + height - 1, y + n)
            elif final == "C":
                x += n
            elif final == "D":
                x = max(0, x - n)
            elif final == "G":
                x = n - 1
            elif final in "Hf":
                y, x = top + n - 1, max(1, nums[1] if len(nums) > 1 else 1) - 1
            elif final == "K":
                if nums[0] == 0:
                    del row[x:]
                elif nums[0] == 1:
                    row[:x + 1] = list(" " * min(len(row), x + 1))
                else:
                    del row[:]
            elif final == "J":
                if nums[0] == 0:
                    del row[x:]
                    del rows[y + 1:]
                elif nums[0] in (2, 3):
                    for i in range(top, len(rows)):
                        rows[i] = []
    out = ["".join(r).rstrip() for r in rows]
    while out and not out[-1].strip():
        out.pop()
    return out


def last(text):
    rows = [ln for ln in (text or "").splitlines() if ln.strip()]
    return rows[-1][:160] if rows else ""


def on_pty(argv, env, cwd, cols, answer=None, wall=60):
    """argv on a pty of `cols` columns, `answer` typed once the question shows: (exit, text)."""
    master, slave = os.openpty()
    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 24, cols, 0, 0))
    try:
        p = spawn(argv, stdin=slave, stdout=slave, stderr=slave, env=env, cwd=cwd, close_fds=True)
    finally:
        os.close(slave)
    chunks, sent, end = [], answer is None, time.monotonic() + wall
    try:
        while time.monotonic() < end:
            if not sent and b"now?" in b"".join(chunks):
                time.sleep(0.2)
                os.write(master, answer.encode() + b"\n")
                sent = True
            ready, _, _ = select.select([master], [], [], 1)
            if not ready:
                if p.poll() is not None:
                    break
                continue
            try:
                data = os.read(master, 65536)
            except OSError:
                break
            if not data:
                break
            chunks.append(data)
    finally:
        os.close(master)
        stop(p)
    return p.returncode, b"".join(chunks).decode("utf-8", "replace")


def spawn(argv, **kw):
    """A child in a session and process group of its own, kept in LIVE until `stop`."""
    p = subprocess.Popen(argv, start_new_session=True, **kw)
    LIVE.add(p)
    return p


def descendants(pid):
    """The pids under `pid`, read from ps: a child a command started in a session of its own
    leaves the group, not the tree."""
    ps = subprocess.run(["/bin/ps", "-axo", "pid=,ppid="], capture_output=True, text=True).stdout
    under, out = {}, []
    for row in ps.splitlines():
        kid, parent = (int(n) for n in row.split())
        under.setdefault(parent, []).append(kid)
    todo = list(under.get(pid, []))
    while todo:
        kid = todo.pop()
        out.append(kid)
        todo += under.get(kid, [])
    return out


def stop(p):
    """The child and its process group gone, waited for, whether it ended or not, so a child it
    put in the background does not outlive it (review 1 L4); while it runs, its tree first."""
    kids = descendants(p.pid) if p.poll() is None else []
    for kid in kids:
        for kill in (os.killpg, os.kill):
            try:
                kill(kid, signal.SIGKILL)
            except OSError:
                pass
    try:
        os.killpg(p.pid, signal.SIGKILL)
    except OSError:
        pass
    p.wait()
    LIVE.discard(p)


def run_child(argv, env, cwd, wall):
    """argv in a pipe, stdin at /dev/null: (exit, stdout, stderr); stopped with its group at the
    wall or when it returns."""
    p = spawn(argv, env=env, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
              stderr=subprocess.PIPE, text=True)
    try:
        out, err = p.communicate(timeout=wall)
    except subprocess.TimeoutExpired:
        out, err = "", "still running at %g s" % wall
    finally:
        stop(p)
    return p.returncode, out, err


def render(argv, env, cwd, way, answer):
    """The screen's lines one way: on a pty, the rows its terminal shows at the end (`replay`);
    in a pipe, stdout's lines then stderr's."""
    if way == "pipe":
        code, out, err = run_child(argv, dict(env, COLUMNS="80"), cwd, 120)
        text = out + err
    else:
        cols = 50 if way == "pty50" else 80
        more = {"NO_COLOR": "1"} if way == "nocolor" else {}
        _, text = on_pty(argv, dict(env, TERM="xterm-256color", **more), cwd, cols, answer)
        return replay(text, cols)
    rows = lines_of(text)
    while rows and not rows[-1].strip():
        rows.pop()
    return rows


# ---- the five checks ------------------------------------------------------------------------

def cells(line):
    """The columns a line takes: a wide or full-width character two, a combining one none."""
    n = 0
    for ch in line:
        if unicodedata.combining(ch):
            continue
        n += 2 if unicodedata.east_asian_width(ch) in "WF" else 1
    return n


# design/23's heads over a command that is never cut, each at column 0 (sc8's two, then
# `same as:`, `from a list:` and `usage:`); a `check` or `undo` row puts its command under its label
LONE_HEADS = ("next: ", "other plugins: ", "same as: ", "from a list: ", "usage: ")
LEAD = 6  # apply.LEAD: a command that does not fit its row stands at this column under it
EXAMPLES = 2  # help <verb>'s examples: one that does not fit beside its gloss stands here alone
RESULT = re.compile(r" \d+ s\b|\bfailed\b|\bstopped\b|could not start")


def lone(line):
    """A line that is one path or one command and nothing more, which cannot be broken, as sc8's
    `lone` has it (review 1 F3): after one of LONE_HEADS at column 0, a path or `claude `; else, on
    a line indented by LEAD, a path or `claude ` and nothing more: no gap of a table's cells and
    no result words; or, at EXAMPLES, `help <verb>`'s example by the path typed and nothing more
    (row sc17-narrow-screens R3). A line of plain words, at column 0 or indented otherwise, is not
    lone."""
    for head in LONE_HEADS:
        if line.startswith(head):
            rest = line[len(head):]
            return rest.startswith(("/", "~/", "./", "claude ")) and not RESULT.search(rest)
    rest = line.strip()
    if re.match(" {%d}[^ ]" % EXAMPLES, line):
        starts = ("/", "~/", "./")
    elif re.match(" {%d}[^ ]" % LEAD, line):
        starts = ("/", "~/", "./", "claude ")
    else:
        return False
    return rest.startswith(starts) and "  " not in rest and not RESULT.search(rest)


def check_width(rows, cols):
    """Check 1: each line past `cols` that is not lone, as `line <n> (<cells>): <text>`."""
    return ["line %d (%d): %s" % (i + 1, cells(r), r[:60]) for i, r in enumerate(rows)
            if cells(r) > cols and not lone(r)]


def check_name(rows):
    """Check 2: each line through the door that holds `agentik-suite` but as a path ending in it."""
    bad = []
    for i, row in enumerate(rows):
        for word in row.split():
            word = word.strip("`'\",;:()")
            if "agentik-suite" in word and not ("/" in word and word.endswith("/agentik-suite")):
                bad.append("line %d: %s" % (i + 1, row[:60]))
                break
    return bad


V9_WORD = re.compile(r"\bexit", re.I)  # exit, exits, exited, and exiting or exitcode (review 1 L1)
V9_CODE = re.compile(r"\{(exit|code|exit_code|rc|returncode|status_code)\}")
MESSAGE = re.compile(r"- `([^`]+)`: (.*)$")


def check_v9(text, allowed=None):
    """Check 3, over the catalogue's text: ([each id outside `allowed` whose message holds the
    word or a code], [each id of `allowed` whose message holds neither])."""
    allowed = V9_LIST if allowed is None else allowed
    held, red = set(), []
    for line in text.splitlines():
        m = MESSAGE.match(line)
        if not m:
            continue
        mid, body = m.groups()
        if V9_WORD.search(body) or V9_CODE.search(body):
            held.add(mid)
            if mid not in allowed:
                red.append(mid)
    return red, sorted(set(allowed) - held)


def spill(line):
    """A command or path that did not fit beside its row, on its own indented line."""
    rest = line.strip()
    return (line.startswith(" ") and rest.startswith(("/", "~/", "./")) and "  " not in rest
            and not rest.endswith(":") and not RESULT.search(rest))


def count(rows):
    """A screen's lines as its budget counts them: each line but a spill directly under a line
    that is not one, so a row spills one line and a second spill in a row counts (review 1 L3)."""
    return sum(1 for i, r in enumerate(rows)
               if not (i and spill(r) and not spill(rows[i - 1])))


def check_budget(screen, rows, budget=None):
    """Check 4: the screen's count on a pty at 80 past its budget, as a list of one."""
    budget = BUDGET if budget is None else budget
    if screen not in budget:
        return ["no budget for %s" % screen]
    most, why = budget[screen]
    n = count(rows)
    return ["%d lines, budget %d (%s)" % (n, most, why)] if n > most else []


PASTE = re.compile(r"^\s*(?:next:|check|undo)\s+(\S.*)$")


def pastes(rows):
    """Each command a `next:`, `check` or `undo` line of the screen gives, in order."""
    return [m.group(1).strip() for m in map(PASTE.match, rows) if m]


def check_paste(command, env, cwd, wall=WALL):
    """Check 5: the command by `sh -c` with stdin at /dev/null, in a process group of its own
    that is stopped when it returns or the wall falls: [] when it returns in the wall with an exit
    other than 127, else [why]. A line that holds a backtick or `$(` is red and is not run (review
    1 L6): a screen's command is pasted as it reads."""
    if "`" in command or "$(" in command:
        return ["not a line to paste: it holds a backtick or $("]
    start = time.monotonic()
    p = spawn(["/bin/sh", "-c", command], env=env, cwd=cwd, stdin=subprocess.DEVNULL,
              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        code = p.wait(timeout=wall)
    except subprocess.TimeoutExpired:
        stop(p)
        return ["waits: still running at %g s" % wall]
    finally:
        stop(p)
    if code == 127:
        return ["not found: exit 127 after %.1f s" % (time.monotonic() - start)]
    return []


# ---- the run --------------------------------------------------------------------------------

def run(root, only, wall, keep):
    launcher = str(Path(root) / "plugins" / "suite" / "bin" / "agentik-suite")
    catalogue = Path(root) / "plugins" / "suite" / "lib" / "agentik_suite" / "messages.md"
    if not os.access(launcher, os.X_OK) or not catalogue.is_file():
        print("screen-probe: no suite under %s" % root, file=sys.stderr)
        return 2
    red, stale = check_v9(catalogue.read_text(encoding="utf-8"))
    verdict("v9", "catalogue", ["%s holds the word or a code" % m for m in red],
            "v9: no message outside the list of %d holds exit or a code" % len(V9_LIST))
    for mid in stale:
        say("note", "v9: %s is listed and holds neither; take it off V9_LIST" % mid)
    chosen = [s for s in SCREENS if only is None or s[0] in only]
    top = os.path.realpath(tempfile.mkdtemp(prefix="screen-probe-"))
    try:
        homes = build_homes(top, launcher, {s[1] for s in chosen}) if chosen else {}
        pasted, n = {}, 0
        for name, label, how, words, fresh in chosen:
            shown = {}
            for way in WAYS:
                home = homes[label]
                if fresh:
                    n += 1
                    home = home.copy("%s-%d" % (label, n))
                answer = "n" if name == "setup-no" and way != "pipe" else None
                shown[way] = render(argv_of(how, home, words, launcher), home.env(), home.work,
                                    way, answer)
                for command in pastes(shown[way]):  # once in each home that printed it
                    pasted.setdefault((home.home, command), (name, label, home))
            bad = []
            for way in ("pty80", "pty50", "nocolor"):
                bad += ["%s %s" % (way, b) for b in check_width(shown[way], 50 if way == "pty50" else 80)]
            verdict("width", name, bad, "width: %s fits 80 and 50 columns" % name)
            if how == "door":
                bad = ["%s %s" % (w, b) for w in WAYS for b in check_name(shown[w])]
                verdict("name", name, bad, "name: %s through the door names no agentik-suite" % name)
            verdict("budget", name, check_budget(name, shown["pty80"]),
                    "budget: %s is %d lines at 80, at most %s" % (
                        name, count(shown["pty80"]), BUDGET.get(name, ("?",))[0]))
        for (_, command), (name, label, home) in pasted.items():
            verdict("paste", name, check_paste(command, home.env(), home.work, wall),
                    "paste: %s, in %s: %s" % (name, label, command))
    finally:
        for p in list(LIVE):  # a stop from outside: each child still running, then T
            stop(p)
        if keep:
            say("note", "kept " + top)
        else:
            shutil.rmtree(top, ignore_errors=True)
    if FAILS:
        print("screen-probe: stop: %d failed" % len(FAILS))
        return 1
    print("screen-probe: go")
    return 0


class Stopped(BaseException):
    """SIGTERM or SIGINT from outside, raised where the probe stands so each `finally` runs."""


def stopped(signum, frame):
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, signal.SIG_IGN)  # the cleanup is not cut by a second one
    raise Stopped(signum)


def main(argv):
    root, only, wall, keep = str(HERE), None, WALL, False
    args = list(argv)
    try:
        while args:
            a = args.pop(0)
            if a == "--root":
                root = os.path.realpath(args.pop(0))
            elif a == "--only":
                only = set(args.pop(0).split(","))
            elif a == "--wall":
                wall = float(args.pop(0))
            elif a == "--keep":
                keep = True
            else:
                raise ValueError(a)
    except (IndexError, ValueError):
        print(USAGE, file=sys.stderr)
        return 2
    if only:
        only.discard("catalogue")  # the catalogue's check alone, no screen
    if only is not None and not only <= {s[0] for s in SCREENS}:
        print(USAGE, file=sys.stderr)
        return 2
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, stopped)
    try:
        return run(root, only, wall, keep)
    except Stopped as e:
        print("screen-probe: stop: %s" % signal.Signals(e.args[0]).name, flush=True)
        return 128 + e.args[0]


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
