#!/usr/bin/env python3
"""marketplace-check: the shape of the `agentik` marketplace (agentik-r1 5.2).

Usage: marketplace-check [--local] [FILE]

FILE defaults to `.claude-plugin/marketplace.json`. The file is a JSON object
named `agentik`, with `owner.name`, and six plugins, each named once: the five
tools, session, decisions, respeak, relay and agents, and `suite`, the
manifest-only plugin in this repo whose dependencies install three of them (hq
design/04 section 5). Each tool's `source` is `{"source": "git-subdir", "url":
..., "path": "plugin"}`, its url `https://github.com/agentik-dev/agentik-<name>.git`;
suite's is commons' own url, `https://github.com/agentik-dev/agentik-commons.git`,
with `path` `plugins/suite`. Every `version` is semver.

Under `--local` (the file `make local-marketplace` writes) each url is a
`file://` url whose last path segment is `agentik-<name>`; the five are still
required, suite is absent (this Mac installs the tools by name, and suite
present is one problem line), and the file may hold further entries after the
five, from the owner's overlay (a plugin whose repo is not public). Each further
entry has the same shape as the five's: a name matching
`[a-z][a-z0-9]*(-[a-z0-9]+)*`, every name once (so an overlay that repeats one
of the five fails), `git-subdir`, a `file://` url whose last segment is
`agentik-<name>`, `path` `plugin` and a semver `version`. The valid line counts
the entries found. Without `--local` the file holds exactly the six, on their
public urls. Nothing is fetched: the check reads the file only.

Exit codes report the task, not the content: 0 the file is valid, 1 a check
said no (each on one stderr line), 2 usage or no readable file. Stdlib only.
"""
import json
import re
import sys
from urllib.parse import unquote, urlsplit

NAME = "agentik"
TOOLS = ("session", "decisions", "respeak", "relay", "agents")
SUITE = "suite"
PUBLISHED = TOOLS + (SUITE,)
PUBLIC = "https://github.com/agentik-dev/agentik-%s.git"
COMMONS = PUBLIC % "commons"
SUITE_PATH = "plugins/suite"
DEFAULT = ".claude-plugin/marketplace.json"
USAGE = "usage: marketplace-check [--local] [FILE]"
SEMVER = re.compile(
    r"(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)"
    r"(?:-(?:0|[1-9]\d*|\d*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9]\d*|\d*[A-Za-z-][0-9A-Za-z-]*))*)?"
    r"(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?\Z")
ID = re.compile(r"[a-z][a-z0-9]*(?:-[a-z0-9]+)*\Z")


def not_json(name):
    """NaN, Infinity and -Infinity: Python reads them, JSON has no such value."""
    raise ValueError("%s is not a JSON value" % name)


def url_ok(url, tool, local):
    if not isinstance(url, str):
        return False
    if not local:
        return url == (COMMONS if tool == SUITE else PUBLIC % tool)
    parts = urlsplit(url)
    path = unquote(parts.path)
    return (parts.scheme == "file" and parts.netloc == "" and path.startswith("/")
            and path.rstrip("/").rsplit("/", 1)[-1] == "agentik-" + tool
            and not parts.query and not parts.fragment)


def problems(data, local):
    """Each check that said no, one line each; [] when the file is valid."""
    if not isinstance(data, dict):
        return ["the top level is not an object"]
    out = []
    if data.get("name") != NAME:
        out.append("name is not %r" % NAME)
    owner = data.get("owner")
    if not (isinstance(owner, dict) and isinstance(owner.get("name"), str) and owner["name"]):
        out.append("owner.name is missing")
    plugins = data.get("plugins")
    if not isinstance(plugins, list):
        return out + ["plugins is not a list"]
    names = [p.get("name") if isinstance(p, dict) else None for p in plugins]
    if local:
        out += ["plugins lacks %s" % tool for tool in TOOLS if tool not in names]
        repeated = sorted({n for n in names if isinstance(n, str) and names.count(n) > 1})
        out += ["plugin name %s appears %d times" % (n, names.count(n)) for n in repeated]
    elif sorted(map(str, names)) != sorted(PUBLISHED):
        # one line: what is lacking, when that is all, else the names found
        if len(set(names)) == len(names) and set(names) < set(PUBLISHED):
            out.append("plugins lacks %s" % ", ".join(t for t in PUBLISHED if t not in names))
        else:
            out.append("plugins holds %d entries, %s, not the %d: %s"
                       % (len(plugins), ", ".join(map(str, names)), len(PUBLISHED),
                          ", ".join(PUBLISHED)))
    for i, plugin in enumerate(plugins):
        if not isinstance(plugin, dict):
            out.append("plugins[%d] is not an object" % i)
            continue
        tool = plugin.get("name")
        where = "plugins[%d] (%s)" % (i, tool)
        named = isinstance(tool, str) and bool(ID.match(tool)) if local else tool in PUBLISHED
        if local and not named:
            out.append("%s: name is not a lowercase id" % where)
        if local and tool == SUITE:
            out.append("%s: suite is in a local file; this Mac installs the tools by name" % where)
            continue
        source = plugin.get("source")
        if not isinstance(source, dict):
            out.append("%s: source is not an object" % where)
            continue
        if source.get("source") != "git-subdir":
            out.append("%s: source.source is not 'git-subdir'" % where)
        if not named or not url_ok(source.get("url"), tool, local):
            out.append("%s: source.url is not the %s url for agentik-%s"
                       % (where, "file://" if local else "public",
                          "commons" if tool == SUITE else tool))
        path = SUITE_PATH if tool == SUITE else "plugin"
        if source.get("path") != path:
            out.append("%s: source.path is not %r" % (where, path))
        version = plugin.get("version")
        if not (isinstance(version, str) and SEMVER.match(version)):
            out.append("%s: version is not semver" % where)
    return out


def main(argv):
    args = argv[1:]
    if args in (["-h"], ["--help"]):
        print(USAGE)
        return 0
    local = "--local" in args
    rest = [a for a in args if a != "--local"]
    if len(rest) > 1 or any(a.startswith("-") for a in rest) or args.count("--local") > 1:
        sys.stderr.write(USAGE + "\n")
        return 2
    path = rest[0] if rest else DEFAULT
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except (OSError, UnicodeDecodeError) as exc:
        sys.stderr.write("marketplace-check: cannot read %s: %s\n" % (path, exc))
        return 2
    try:
        data = json.loads(text, parse_constant=not_json)
        found = problems(data, local)
    except ValueError as exc:
        found = ["not JSON: %s" % exc]
    for line in found:
        sys.stderr.write("marketplace-check: %s: %s\n" % (path, line))
    if found:
        return 1
    print("marketplace-check: %s: %s, %d plugins, valid" % (path, NAME, len(data["plugins"])))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
