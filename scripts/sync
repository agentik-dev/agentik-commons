#!/bin/sh
# sync: refresh the vendored copies in a tool repo (agentik-r1 7.3, hq design/04 §7 item 4).
#
#   scripts/sync <repo>
#
# Copies bin/agentik to <repo>/scripts/agentik, and scripts/hygiene,
# scripts/recordlint, scripts/readme-top, scripts/bounded, scripts/plugin-version-check and
# scripts/plugin-description-bytes to <repo>/scripts/, then
# writes <repo>/scripts/vendored.sha256 in `shasum -a 256 -c` form, its paths
# from the repo's root; the repo's `make check` runs that check, and runs
# plugin-version-check and plugin-description-bytes where the repo has a plugin/
# (GUIDE §1, §5), and its doclint
# target runs recordlint (hq design/05 §4).
#
# A repo with a plugin/lib/ also gets, in the same file, scripts/agentik_install.py
# at plugin/lib/agentik_install.py, scripts/agentik_records.py, the records root's resolver
# (GUIDE §12), at plugin/lib/agentik_records.py, scripts/plugin-launcher at
# plugin/bin/agentik-<tool> and bin/agentik at plugin/bin/agentik (GUIDE §10).
# <tool> is plugin/lib/agentik-tool.conf's tool_name when that file exists; when
# not, plugin/.claude-plugin/plugin.json's name, and this writes the file once
# from it, the tool's own to edit, never listed. It touches nothing else and
# never commits: the packet that runs it does, and bumps the plugin (GUIDE §7).
# The same repo gets the writer the suite draws with, as the package plugin/lib/agentik_term/:
# term.py and catalogue.py from plugins/suite/lib/agentik_suite/ and an __init__.py this
# writes, all three listed; and, once, when absent, plugin/lib/agentik_term/messages.md, the
# tool's own catalogue, seeded with each id term.py names and commons' text for it, never listed.
# A plugin/ with no lib/ gets the set a repo with no plugin/ gets.
# Exit 0 done; 2 usage, a target that is not a git checkout (or is this repo),
# a plugin/lib/ that names no tool, or a seed id commons' messages.md lacks, with nothing written. CDPATH is never followed.
set -eu

usage() {
	echo "usage: scripts/sync [--check] <repo>" >&2
	exit 2
}

check=
if [ $# -ge 1 ] && [ "$1" = --check ]; then
	check=1
	shift
fi
[ $# -eq 1 ] || usage
case $1 in -*) usage ;; esac
here=$(CDPATH= cd -P -- "$(dirname -- "$0")/.." >/dev/null && pwd -P)
if ! [ -d "$1" ] || ! [ -e "$1/.git" ]; then
	echo "sync: $1 is not a git checkout" >&2
	exit 2
fi
target=$(CDPATH= cd -P -- "$1" >/dev/null && pwd -P)
if [ "$target" = "$here" ]; then
	echo "sync: $target is agentik-commons itself, the source of the copies" >&2
	exit 2
fi
if command -v shasum >/dev/null 2>&1; then
	sum() { shasum -a 256 "$@"; }
elif command -v sha256sum >/dev/null 2>&1; then
	sum() { sha256sum "$@"; }
else
	echo "sync: neither shasum nor sha256sum is on PATH" >&2
	exit 2
fi

# The tool's name, read before anything is written. The C locale makes the name check's ranges
# bytes, never a locale's collation, where [a-z] holds F and a letter may be é.
LC_ALL=C
export LC_ALL
conf=$target/plugin/lib/agentik-tool.conf
tool=
word=
if [ -d "$target/plugin/lib" ]; then
	if [ -f "$conf" ]; then
		if grep -Eq '^[[:space:]]|[[:space:]]$' "$conf"; then
			echo "sync: $conf has whitespace or a CR around a line, which install-cli and the launcher refuse" >&2
			exit 2
		fi
		tool=$(sed -n 's/^tool_name=//p' "$conf" | head -n 1)
	else
		word=$(python3 -I -c 'import json, sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["name"])' \
			"$target/plugin/.claude-plugin/plugin.json" 2>/dev/null) || word=
		tool=agentik-$word
	fi
	case ${tool#agentik-} in
	"" | *[!a-z0-9-]* | [!a-z]*) tool= ;;
	esac
	case $tool in
	agentik-*) ;;
	*)
		echo "sync: $target/plugin names no tool: neither a tool_name in plugin/lib/agentik-tool.conf nor a usable name in plugin/.claude-plugin/plugin.json" >&2
		exit 2
		;;
	esac
fi

# The ids term.py names itself (Term.error's err.next), each with its line in commons' catalogue,
# for a tool's own messages.md (packet ak10b-term R2); read before anything is written.
writer=plugins/suite/lib/agentik_suite
term_ids="err.next"
seed=
if [ -n "$tool" ]; then
	for id in $term_ids; do
		item=$(awk -v p="- \`$id\`: " 'index($0, p) == 1 { print; exit }' "$here/$writer/messages.md")
		if [ -z "$item" ]; then
			echo "sync: $here/$writer/messages.md has no line for $id, which term.py names" >&2
			exit 2
		fi
		seed="$seed$item
"
	done
fi

# sync's own bytes for the package's __init__.py, listed like a copy.
init_text='"""agentik_term: the one writer, term, and its catalogue, placed by agentik-commons scripts/sync (GUIDE section 10); messages.md beside them is the tool'"'"'s own."""'

# The one table the write path and the check both read (packet sy4-sync-check R1): a line a file,
# its source under this repo, its destination under the target, its mode, and y where
# vendored.sha256 lists it, in the file's order. :init is init_text; :messages and :conf are the
# tool's own, seeded once when absent, never listed and never compared (n, mode -).
table() {
	for f in agentik hygiene recordlint readme-top bounded plugin-version-check plugin-description-bytes; do
		case $f in agentik) src=bin/agentik ;; *) src=scripts/$f ;; esac
		echo "$src scripts/$f 755 y"
	done
	[ -n "$tool" ] || return 0
	echo "scripts/agentik_install.py plugin/lib/agentik_install.py 644 y"
	echo "scripts/agentik_records.py plugin/lib/agentik_records.py 644 y"
	echo ":init plugin/lib/agentik_term/__init__.py 644 y"
	echo "$writer/term.py plugin/lib/agentik_term/term.py 644 y"
	echo "$writer/catalogue.py plugin/lib/agentik_term/catalogue.py 644 y"
	echo "scripts/plugin-launcher plugin/bin/$tool 755 y"
	echo "bin/agentik plugin/bin/agentik 755 y"
	echo ":messages plugin/lib/agentik_term/messages.md - n"
	echo ":conf plugin/lib/agentik-tool.conf - n"
}
rows=$(table)
listed=$(printf '%s\n' "$rows" | awk '$4 == "y" { print $2 }')

if [ -n "$check" ]; then
	# Reads only: nothing is created, changed or removed, here or in the target.
	behind=
	while read -r src dst mode mark; do
		[ "$mark" = y ] || continue
		f=$target/$dst
		if [ -L "$f" ] || ! [ -f "$f" ]; then
			behind="$behind$dst
"
		elif [ "$src" = :init ] && ! printf '%s\n' "$init_text" | cmp -s - "$f"; then
			behind="$behind$dst
"
		elif [ "$src" != :init ] && ! cmp -s "$here/$src" "$f"; then
			behind="$behind$dst
"
		elif [ -z "$(find "$f" -prune -perm "$mode")" ]; then
			behind="$behind$dst
"
		fi
	done <<EOF
$rows
EOF
	have=
	if [ -f "$target/scripts/vendored.sha256" ]; then
		have=$(sed -n 's/^[^ ]* [ *]//p' "$target/scripts/vendored.sha256" | sort -u)
	fi
	unlisted=$(printf '%s\n%s\n' "$have" "$(printf '%s\n' "$listed" | sort -u)" | sed '/^$/d' | sort | uniq -u)
	behind=$(printf '%s' "$behind" | sort -u)
	if [ -z "$behind$unlisted" ]; then
		echo "sync: $target: every copy is commons'"
		exit 0
	fi
	[ -z "$behind" ] || printf '%s\n' "$behind" | sed 's/^/behind /'
	[ -z "$unlisted" ] || printf '%s\n' "$unlisted" | sed 's/^/unlisted /'
	exit 1
fi

place() { # source under this repo (or :init), destination under the target, mode
	dir=$target/${2%/*}
	temp=$dir/.${2##*/}.sync.$$
	mkdir -p "$dir"
	if [ "$1" = :init ]; then
		printf '%s\n' "$init_text" >"$temp"
	else
		cp "$here/$1" "$temp"
	fi
	chmod "$3" "$temp"
	mv -f "$temp" "$target/$2"
}

while read -r src dst mode mark; do
	case $src in
	:messages)
		pkg=$target/${dst%/*}
		if ! [ -e "$pkg/messages.md" ] && ! [ -L "$pkg/messages.md" ]; then
			{
				printf '# Messages\n\n'
				printf '%s\n\n' "This catalogue is the tool's own, not a vendored copy: scripts/sync wrote it once and never writes it again. Each message the tool prints through term is one item here, by its id (GUIDE section 10)."
				printf '%s' "$seed"
			} >"$pkg/messages.md.sync.$$"
			mv -f "$pkg/messages.md.sync.$$" "$pkg/messages.md"
		fi
		;;
	:conf)
		if ! [ -f "$conf" ]; then
			cat >"$conf.sync.$$" <<CONF
# This tool's names, for the canonical install-cli and launchers (GUIDE §10); not a vendored copy.
tool_name=$tool
remedy=/$word:install-cli
runner=$tool
old_name=
old_state=
CONF
			mv -f "$conf.sync.$$" "$conf"
		fi
		;;
	*) place "$src" "$dst" "$mode" ;;
	esac
done <<EOF
$rows
EOF
said="agentik, hygiene, recordlint, readme-top, bounded, plugin-version-check, plugin-description-bytes, vendored.sha256"
# shellcheck disable=SC2086 # the paths are this script's own, with no space
(CDPATH= cd -P -- "$target" >/dev/null && sum $listed) >"$target/scripts/.vendored.sync.$$"
mv -f "$target/scripts/.vendored.sync.$$" "$target/scripts/vendored.sha256"
echo "sync: $target/scripts: $said"
[ -z "$tool" ] || echo "sync: $target/plugin: lib/agentik_install.py, lib/agentik_records.py, lib/agentik_term/__init__.py, lib/agentik_term/term.py, lib/agentik_term/catalogue.py, bin/$tool, bin/agentik"
