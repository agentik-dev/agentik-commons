#!/usr/bin/env python3
"""local-marketplace: the `agentik` marketplace for the owner's machine (agentik-r1 D1).

Usage: local-marketplace PUBLISHED CODE OVERLAY OUT

Reads the published marketplace PUBLISHED, drops its `suite` entry (this Mac
installs the tools by name, and suite's manifest lives in commons, not in a
checkout of its own), appends the entries of OVERLAY after the five, in the
overlay's order, rewrites every url to
`file://CODE/agentik-<name>` and writes the result to OUT. The overlay is the
owner's file, kept outside every repo, for a plugin whose repo is not public: a
JSON object whose `plugins` lists entries in the published form, so an entry
moves to the published file unchanged once its repo is public. An absent
overlay (no such file) adds nothing: OUT is then the published file, less
suite, with `file://` urls. `make local-marketplace` runs this, then
`marketplace-check --local OUT`, which holds each entry to its shape.

Nothing is written, and OUT's folder is not made, unless every input reads.
NaN and Infinity are not JSON here. Exit codes report the task, not the
content: 0 written, 1 a file is not JSON or the overlay has no `plugins` list,
2 usage or a file that cannot be read; each failure is one stderr line.
Stdlib only; nothing is fetched.
"""
import json
import os
import sys
from pathlib import Path

USAGE = "usage: local-marketplace PUBLISHED CODE OVERLAY OUT"
SUITE = "suite"


class Refused(Exception):
    """One stderr line and an exit code."""

    def __init__(self, line, code):
        super().__init__(line)
        self.code = code


def not_json(name):
    """NaN, Infinity and -Infinity: Python reads them, JSON has no such value."""
    raise ValueError("%s is not a JSON value" % name)


def load(path, absent=False):
    """The JSON in path; None when absent is set and there is no such file (a
    dangling symlink is present and unreadable)."""
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except FileNotFoundError as exc:
        if absent and not os.path.islink(path):
            return None
        raise Refused("cannot read %s: %s" % (path, exc), 2)
    except (OSError, UnicodeDecodeError) as exc:
        raise Refused("cannot read %s: %s" % (path, exc), 2)
    try:
        return json.loads(text, parse_constant=not_json)
    except ValueError as exc:
        raise Refused("%s: not JSON: %s" % (path, exc), 1)


def merged(published, code, overlay):
    data = load(published)
    if not (isinstance(data, dict) and isinstance(data.get("plugins"), list)):
        raise Refused("%s: plugins is not a list" % published, 1)
    data["plugins"] = [p for p in data["plugins"]
                       if not (isinstance(p, dict) and p.get("name") == SUITE)]
    extra = load(overlay, absent=True)
    if extra is not None:
        if not (isinstance(extra, dict) and isinstance(extra.get("plugins"), list)):
            raise Refused("%s: plugins is not a list" % overlay, 1)
        data["plugins"] += extra["plugins"]
    for plugin in data["plugins"]:
        if (isinstance(plugin, dict) and isinstance(plugin.get("source"), dict)
                and isinstance(plugin.get("name"), str)):
            plugin["source"]["url"] = Path(code, "agentik-" + plugin["name"]).as_uri()
    return data


def main(argv):
    args = argv[1:]
    if args in (["-h"], ["--help"]):
        print(USAGE)
        return 0
    if len(args) != 4 or any(a.startswith("-") for a in args):
        sys.stderr.write(USAGE + "\n")
        return 2
    published, code, overlay, out = args
    try:
        data = merged(published, code, overlay)
        os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
        with open(out, "w", encoding="utf-8") as fh:
            fh.write(json.dumps(data, indent=2) + "\n")
    except Refused as exc:
        sys.stderr.write("local-marketplace: %s\n" % exc)
        return exc.code
    except OSError as exc:
        sys.stderr.write("local-marketplace: cannot write %s: %s\n" % (out, exc))
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
