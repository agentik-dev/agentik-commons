{
  "about": "The records root's cases (hq design/28 §3 item 6; packet rr2-records-resolver R6). Each case is a layout built under a fresh temp folder, {root}: `clone` a git repo with one commit; `worktrees`, each `git worktree add <path> -b <its last name>`, or `[path, commit]` detached at that commit; `moves` each a folder renamed after the worktrees are made; `key` set by `git config --local` (a list, each by `--add`), `config_text` written at the end of the clone's .git/config, `worktree_key` by `--worktree` in the first worktree, `env_key` through GIT_CONFIG_COUNT; `declare` a file and line in the clone, committed unless `commit` is false (a line added to a committed file is then left uncommitted); `folders` made; `links` a symlink and its target; `holder` a git repo with one commit, its own `declare` too. `resolve` is called from `from`; `needs` skips the case where the temp folder's file system lacks it: `case-blind` (a name in another case is the same file) or `firmlink` (the folder also reached under /System/Volumes/Data); `expect` is the object, or `{\"error\": \"no-repo\"}`. HOME is {root}.",
  "cases": [
    {"name": "own: no key, from the top",
     "clone": "code/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/code/widget",
                "holder": "{root}/code/widget", "prefix": ".", "state": "own", "why": null}},
    {"name": "own: no key, from a folder under the top",
     "clone": "code/widget", "folders": ["code/widget/deep/er"], "from": "code/widget/deep/er",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/code/widget",
                "holder": "{root}/code/widget", "prefix": ".", "state": "own", "why": null}},
    {"name": "own: a worktree answers its own top",
     "clone": "code/widget", "worktrees": ["code/widget-b"], "from": "code/widget-b",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/code/widget-b",
                "holder": "{root}/code/widget-b", "prefix": ".", "state": "own", "why": null}},
    {"name": "own: a line in an untracked .hygiene-allow declares nothing",
     "clone": "code/widget", "declare": {"file": ".hygiene-allow", "line": "records: out", "commit": false},
     "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/code/widget",
                "holder": "{root}/code/widget", "prefix": ".", "state": "own", "why": null}},
    {"name": "own: a line not yet committed in a tracked config.yaml declares nothing",
     "clone": "code/widget", "declare": {"file": ".claude/agentik/config.yaml", "line": "suite.records: out", "commit": false, "tracked": true},
     "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/code/widget",
                "holder": "{root}/code/widget", "prefix": ".", "state": "own", "why": null}},
    {"name": "own: a --worktree value is not read",
     "clone": "code/widget", "worktrees": ["code/widget-b"], "folders": ["recs/widget"],
     "worktree_key": "{root}/recs/widget", "from": "code/widget-b",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/code/widget-b",
                "holder": "{root}/code/widget-b", "prefix": ".", "state": "own", "why": null}},
    {"name": "own: a GIT_CONFIG_COUNT value is not read",
     "clone": "code/widget", "folders": ["recs/widget"], "env_key": "{root}/recs/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/code/widget",
                "holder": "{root}/code/widget", "prefix": ".", "state": "own", "why": null}},
    {"name": "out: a plain folder in no repository",
     "clone": "code/widget", "folders": ["recs/widget"], "key": "{root}/recs/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/recs/widget",
                "holder": null, "prefix": null, "state": "out", "why": null}},
    {"name": "out: a folder of a holder",
     "clone": "code/widget", "holder": {"path": "hq"}, "folders": ["hq/repos/widget"],
     "key": "{root}/hq/repos/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/hq/repos/widget",
                "holder": "{root}/hq", "prefix": "repos/widget", "state": "out", "why": null}},
    {"name": "out: from a worktree, the main checkout's key",
     "clone": "code/widget", "worktrees": ["code/widget-b"], "holder": {"path": "hq"}, "folders": ["hq/repos/widget"],
     "key": "{root}/hq/repos/widget", "from": "code/widget-b",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/hq/repos/widget",
                "holder": "{root}/hq", "prefix": "repos/widget", "state": "out", "why": null}},
    {"name": "out: git expands ~ to HOME",
     "clone": "code/widget", "holder": {"path": "hq"}, "folders": ["hq/repos/widget"],
     "key": "~/hq/repos/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/hq/repos/widget",
                "holder": "{root}/hq", "prefix": "repos/widget", "state": "out", "why": null}},
    {"name": "out: a declared tree with a key that resolves",
     "clone": "code/widget", "declare": {"file": ".hygiene-allow", "line": "records: out"},
     "holder": {"path": "hq"}, "folders": ["hq/repos/widget"], "key": "{root}/hq/repos/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/hq/repos/widget",
                "holder": "{root}/hq", "prefix": "repos/widget", "state": "out", "why": null}},
    {"name": "out: the holder's own top",
     "clone": "code/widget", "holder": {"path": "widget"}, "key": "{root}/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/widget",
                "holder": "{root}/widget", "prefix": ".", "state": "out", "why": null}},
    {"name": "unset: declared in .hygiene-allow, no key",
     "clone": "code/widget", "declare": {"file": ".hygiene-allow", "line": "records: out"}, "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "unset", "why": "no-key"}},
    {"name": "own: a committed suite.records line in config.yaml declares nothing (C3)",
     "clone": "code/widget", "declare": {"file": ".claude/agentik/config.yaml", "line": "suite.records: out"},
     "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/code/widget",
                "holder": "{root}/code/widget", "prefix": ".", "state": "own", "why": null}},
    {"name": "unset: declared, from a worktree",
     "clone": "code/widget", "worktrees": ["code/widget-b"], "declare": {"file": ".hygiene-allow", "line": "records: out"},
     "from": "code/widget-b",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "unset", "why": "no-key"}},
    {"name": "broken: a relative value",
     "clone": "code/widget", "folders": ["code/widget/recs/widget"], "key": "recs/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "relative"}},
    {"name": "broken: an empty value",
     "clone": "code/widget", "key": "", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "relative"}},
    {"name": "broken: no folder there",
     "clone": "code/widget", "key": "{root}/nowhere/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "missing"}},
    {"name": "broken: inside the main checkout",
     "clone": "code/widget", "folders": ["code/widget/recs/widget"], "key": "{root}/code/widget/recs/widget",
     "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "inside"}},
    {"name": "broken: inside a worktree of the clone",
     "clone": "code/widget", "worktrees": ["code/widget-b"], "folders": ["code/widget-b/x/widget"],
     "key": "{root}/code/widget-b/x/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "inside"}},
    {"name": "broken: a link from outside into the clone, by real path",
     "clone": "code/widget", "folders": ["code/widget/recs/widget", "links"],
     "links": [["links/widget", "code/widget/recs/widget"]], "key": "{root}/links/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "inside"}},
    {"name": "broken: its last name is not the clone's",
     "clone": "code/widget", "folders": ["recs/gadget"], "key": "{root}/recs/gadget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "name"}},
    {"name": "broken: a holder whose tree declares out",
     "clone": "code/widget", "holder": {"path": "pub", "declare": {"file": ".hygiene-allow", "line": "records: out"}},
     "folders": ["pub/repos/widget"], "key": "{root}/pub/repos/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "holder"}},
    {"name": "out: a holder's config.yaml line declares nothing (C3)",
     "clone": "code/widget", "holder": {"path": "pub", "declare": {"file": ".claude/agentik/config.yaml", "line": "suite.records: out"}},
     "folders": ["pub/repos/widget"], "key": "{root}/pub/repos/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/pub/repos/widget",
                "holder": "{root}/pub", "prefix": "repos/widget", "state": "out", "why": null}},
    {"name": "broken: a declared tree never falls back to its root",
     "clone": "code/widget", "declare": {"file": ".hygiene-allow", "line": "records: out"},
     "key": "{root}/nowhere/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "missing"}},
    {"name": "broken: from a worktree",
     "clone": "code/widget", "worktrees": ["code/widget-b"], "folders": ["recs/gadget"],
     "key": "{root}/recs/gadget", "from": "code/widget-b",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "name"}},
    {"name": "broken: an optional form of a missing folder is set, so unread (F1)",
     "clone": "code/widget", "key": ":(optional){root}/nowhere/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "unread"}},
    {"name": "broken: the optional form in a declared tree is unread, never unset (F1)",
     "clone": "code/widget", "declare": {"file": ".hygiene-allow", "line": "records: out"}, "key": ":(optional){root}/nowhere/widget",
     "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "unread"}},
    {"name": "broken: a key with no value is unread (C1)",
     "clone": "code/widget", "config_text": "[agentik]\n\trecords\n", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "unread"}},
    {"name": "broken: a key given twice is many (C1)",
     "clone": "code/widget", "folders": ["recs/widget", "hq/widget"], "key": ["{root}/recs/widget", "{root}/hq/widget"],
     "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "many"}},
    {"name": "broken: the clone in another case is inside (F2)", "needs": "case-blind",
     "clone": "code/widget", "folders": ["code/widget/recs/widget"], "key": "{root}/code/WIDGET/recs/widget",
     "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "inside"}},
    {"name": "broken: the clone in another case, declared, is inside (F2)", "needs": "case-blind",
     "clone": "code/widget", "declare": {"file": ".hygiene-allow", "line": "records: out"}, "folders": ["code/widget/recs/widget"],
     "key": "{root}/code/WIDGET/recs/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "inside"}},
    {"name": "broken: the clone through the data volume's firmlink is inside (F2)", "needs": "firmlink",
     "clone": "code/widget", "folders": ["code/widget/recs/widget"],
     "key": "/System/Volumes/Data{root}/code/widget/recs/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "inside"}},
    {"name": "broken: the firmlink spelling, declared, is inside (F2)", "needs": "firmlink",
     "clone": "code/widget", "declare": {"file": ".hygiene-allow", "line": "records: out"}, "folders": ["code/widget/recs/widget"],
     "key": "/System/Volumes/Data{root}/code/widget/recs/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "inside"}},
    {"name": "broken: a worktree from before the declaration, in another case, is inside (F3)", "needs": "case-blind",
     "clone": "code/widget", "declare": {"file": ".hygiene-allow", "line": "records: out"}, "worktrees": [["elsewhere/wt", "main~1"]],
     "folders": ["elsewhere/wt/widget"], "key": "{root}/elsewhere/WT/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "inside"}},
    {"name": "broken: a moved worktree, not in the list, shares the git folder (F3)",
     "clone": "code/widget", "declare": {"file": ".hygiene-allow", "line": "records: out"}, "worktrees": [["elsewhere/wt", "main~1"]],
     "moves": [["elsewhere/wt", "elsewhere/moved"]], "folders": ["elsewhere/moved/widget"],
     "key": "{root}/elsewhere/moved/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "inside"}},
    {"name": "broken: a last name by case alone (F5)",
     "clone": "code/widget", "folders": ["recs/Widget"], "key": "{root}/recs/Widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "name"}},
    {"name": "broken: a link named as the clone to a folder that is not (C2)",
     "clone": "code/widget", "folders": ["recs/gadget", "links"], "links": [["links/widget", "recs/gadget"]],
     "key": "{root}/links/widget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": null,
                "holder": null, "prefix": null, "state": "broken", "why": "name"}},
    {"name": "out: a folder named as the clone, through a link that is not (C2)",
     "clone": "code/widget", "folders": ["recs/widget", "links"], "links": [["links/gadget", "recs/widget"]],
     "key": "{root}/links/gadget", "from": "code/widget",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/recs/widget",
                "holder": null, "prefix": null, "state": "out", "why": null}},
    {"name": "out: called from the clone in another case, repo as git names it (F5)", "needs": "case-blind",
     "clone": "code/widget", "folders": ["hq/widget"], "key": "{root}/hq/widget", "from": "CODE/WIDGET",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/hq/widget",
                "holder": null, "prefix": null, "state": "out", "why": null}},
    {"name": "own: called from the clone in another case, repo as git names it (F5)", "needs": "case-blind",
     "clone": "code/widget", "from": "CODE/WIDGET",
     "expect": {"schema": "agentik.records/1", "repo": "{root}/code/widget", "records": "{root}/code/widget",
                "holder": "{root}/code/widget", "prefix": ".", "state": "own", "why": null}},
    {"name": "no repo: a folder in no git working tree",
     "clone": "code/widget", "folders": ["loose"], "from": "loose",
     "expect": {"error": "no-repo"}}
  ]
}
