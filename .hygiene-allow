# .hygiene-allow: <path-glob>: <group>[,<group>]; `*` stays inside one path segment.
# Every row sits under its reason (packet agentik-r1-commons, ruling 6).

# agentik-commons exists to name its sibling agentik tools and plugins: the README,
# the records and packets, the backlog, the sibling paragraph, the marketplace,
# its check and that check's test, and the suite's manifest, whose dependencies
# are three of them
README.md: sibling
NICE_TO_HAVE.md: sibling
history/NICE-2026-11-01.md: sibling
design/*.md: sibling
docs/sibling.md: sibling
.claude-plugin/marketplace.json: sibling
scripts/marketplace-check: sibling
tests/test_marketplace.py: sibling
plugins/suite/.claude-plugin/plugin.json: sibling

# the suite's fallback table, beside its package, names the published tools it reads for
# one that does not answer (packet ak1b R7)
plugins/suite/lib/fallback.json: sibling

# the tools an issue may name and the repo each files to, made from the marketplace (packet rp3-gather R2)
plugins/suite/lib/public.json: sibling

# the issue skill hands the draft's two lines to that sibling's narrator agent (packet rp6-verb R8)
plugins/suite/skills/issue/SKILL.md: sibling

# the voice gate runs that sibling's scanner, found by its plugin's name; its test fakes one
scripts/voice: sibling
tests/test_voice.py: sibling

# the launcher step test's first commit named a sibling tool; the file now uses a made-up one
tests/test_sp1_launcher_step.py: sibling

# a packet names its read-only sources by path
design/packets/*.md: sibling,home

# hygiene's own patterns name the old tools; its test assembles them at runtime
scripts/hygiene: renamed
tests/test_hygiene.py: renamed

# the guide's alias paragraph lists the old names; the guide names the five tools
GUIDE.md: renamed,sibling

# the copyright line names its holder
LICENSE: person

# fk1-sources' first commits wrote the ssh form of the suite's hosting URL, user, host and
# repo, which the email group reads; a URL's form, no address (the files now split it)
design/packets/fk1-sources.md: email
plugins/suite/lib/agentik_suite/sources.py: email
tests/test_fk1_sources.py: email
