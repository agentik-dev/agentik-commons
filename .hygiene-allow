# .hygiene-allow: <path-glob>: <group>[,<group>]; `*` stays inside one path segment.
# Every row sits under its reason (packet agentik-r1-commons, ruling 6).

# agentik-commons exists to name its sibling agentik tools and plugins: the README,
# the records and packets, the backlog, the sibling paragraph, the marketplace,
# its check and that check's test, and the suite's manifest, whose dependencies
# are three of them
README.md: sibling
NICE_TO_HAVE.md: sibling
history/NICE-2026-11-01.md: sibling
# the overflow holds rows moved whole from the NICE file, so it reads as that file does
history/NICE-overflow.md: sibling
design/*.md: sibling
docs/sibling.md: sibling
.claude-plugin/marketplace.json: sibling
scripts/marketplace-check: sibling
tests/test_marketplace.py: sibling
plugins/suite/.claude-plugin/plugin.json: sibling

# the tools an issue may name and the repo each files to, made from the marketplace (packet rp3-gather R2)
plugins/suite/lib/public.json: sibling

# the narrator plugin whose script `issue new --render` starts, its script and its mode, as data (packet rp8 R1)
plugins/suite/lib/render.json: sibling

# the suite keeps the word `rows` for one tool's claim, and the table names that tool
# (design/15 P2, packet ak9c R2)
plugins/suite/lib/kept.json: sibling

# the issue skill hands the draft's two lines to that sibling's narrator agent (packet rp6-verb R8)
plugins/suite/skills/issue/SKILL.md: sibling

# the voice gate runs that sibling's scanner, found by its plugin's name; its test fakes one
scripts/voice: sibling
tests/test_voice.py: sibling

# the launcher step test's first commit named a sibling tool; the file now uses a made-up one
tests/test_sp1_launcher_step.py: sibling

# commit 04cf99b named the suite's public tools in this test and 1a621df took them out
tests/test_su6_rows_part.py: sibling

# commit 36d6279 named the suite's default plugins in this test and 74ddbd2 read them from the manifest
tests/test_up1_tree_gone.py: sibling

# a packet names its read-only sources by path
design/packets/*.md: sibling,home

# hygiene's own patterns name the old tools; its test assembles them at runtime
scripts/hygiene: renamed
tests/test_hygiene.py: renamed

# the guide's alias paragraph lists the old names; the guide names the five tools
GUIDE.md: renamed,sibling

# the copyright line names its holder
LICENSE: person

# fk1-sources' first commits wrote the ssh form of the suite's hosting URL, user, host and
# repo, which the email group reads; a URL's form, no address (the files now split it)
design/packets/fk1-sources.md: email
plugins/suite/lib/agentik_suite/sources.py: email
tests/test_fk1_sources.py: email
# su2-screen build 1's charter names a function of status.py by its dotted name, which the lan
# group reads as a host name; it is no host
history/sittings/2026-11-13-18.md: lan
# ak4a-update's first test commit and its record of the sitting hold a Python attribute named
# for a folder, which the lan group reads as a host name; no host is named; its test commit
# 2408ca3 held a made-up spaced path under a home folder, moved since; no home is named
tests/test_ak4a_update.py: lan,home
history/sittings/2026-11-14-11.md: lan

# the first hour's page names the tools a newcomer types
docs/first-hour.md: sibling

# the hq scaffold names the ledger's tool, which a new hq runs (row ak11-init R10)
plugins/suite/lib/scaffold/hq/*: sibling
plugins/suite/lib/scaffold/hq/CLAUDE.md: sibling,renamed

# setup's need rows and the doctor's note name the suite's own public plugins under test, and
# the plug reader's test names a plugin's fallback row (row ic2-needs, the coordinator's ruling)
tests/test_ic2_needs.py: sibling
tests/test_ak9b_plug_reader.py: sibling

# the suite's own tool names in the fixtures that stand in for the old table's tools, each now
# answering describe, and public.json's pages (row ak10c5-table-gone, the coordinator's ruling)
tests/test_ak10c5_table_gone.py: sibling
tests/test_in4_inbox.py: sibling
tests/test_su2_read.py: sibling

# the hq scaffold test's stub checks the verb a new hq runs, as the scaffold names it (row
# dr1-door-ahead, the coordinator's ruling)
tests/test_dr1_door_ahead.py: sibling
# rr2-records-resolver's fixtures commit as a made-up author at the reserved `.invalid`
# domain; an early commit of the branch held the address whole, the tree splits it
tests/test_rr2_records.py: email
