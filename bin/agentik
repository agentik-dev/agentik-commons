#!/bin/sh
# agentik: the front door to the agentik tools (agentik-r1 section 3, packets ak2 and sc13-door);
# GUIDE.md section 10's rows `front door` and `exit codes` say what it does. It reads and
# writes nothing and resolves no old name. POSIX sh.
VERSION=0.3.0
LOWER=abcdefghijklmnopqrstuvwxyz
UPPER=ABCDEFGHIJKLMNOPQRSTUVWXYZ
USAGE="usage: agentik [<verb or tool> [args...]] | agentik help [<verb or tool>] | agentik --version"
NEXT="next: git clone https://github.com/agentik-dev/agentik-commons && agentik-commons/setup"
case $0 in */*) self=${0%/*}/ ;; *) self= ;; esac

usage() { echo "$USAGE" >&2; exit 2; }

# valid NAME: NAME matches ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ (ASCII only, no newline).
valid() {
	case $1 in
	'' | [!$LOWER]* | *[!${LOWER}0123456789-]* | *--* | *-) return 1 ;;
	esac
}

# can FILE: FILE is an executable file, in $hit.
can() { [ -f "$1" ] && [ -x "$1" ] && hit=$1; }

# found NAME: the first agentik-NAME on PATH, else in the door's own folder, in $hit.
# An empty PATH entry, the trailing one included, is the current directory.
found() {
	hit=
	oldifs=$IFS
	IFS=: p=$PATH:
	set -f
	for dir in $p; do can "${dir:-.}/agentik-$1" && break; done
	set +f
	IFS=$oldifs
	[ -n "$hit" ] || { [ -n "$self" ] && can "${self}agentik-$1"; }
}

# target ARGS: the first word after the first that is no flag, in $t.
target() {
	shift
	for t in "$@"; do case $t in -*) ;; *) return 0 ;; esac; done; return 1
}

missing() {
	printf '%s\n' "agentik: $1 is not installed, and neither is the agentik suite" "$NEXT" >&2
	exit 3
}

# refuse WORD: not a name; the word is shown only when it holds no byte a terminal reads.
refuse() {
	case $1 in '' | *[!${LOWER}${UPPER}0123456789._-]*) set -- 'that word' ;; esac
	printf '%s\n' "agentik: $1 is not a name: lowercase letters, digits and dashes" "next: agentik help" >&2
	exit 2
}

# listdir DIR: each agentik-NAME in DIR not yet seen, under set -f.
listdir() {
	set +f
	for path in "$1"agentik-*; do
		name=${path##*/agentik-}
		valid "$name" && can "$path" || continue
		case $seen in *" $name "*) continue ;; esac
		seen="$seen$name "
		[ "$count" -gt 0 ] || echo "tools on PATH:"
		count=$((count + 1))
		printf '  %-12s %s\n' "$name" "$path"
	done
	set -f
}

list() {
	echo "$USAGE"
	seen=' ' count=0 oldifs=$IFS
	IFS=: p=$PATH:
	set -f
	for dir in $p; do listdir "${dir:-.}/"; done
	[ -z "$self" ] || listdir "$self"
	set +f && IFS=$oldifs
	[ "$count" -gt 0 ] || echo "no agentik-* tool on PATH"
	echo "$NEXT" >&2
	exit 0
}

[ $# -gt 0 ] || { found suite && exec "$hit"; list; }
if [ "$1" = help ]; then
	target "$@" && valid "$t" && found "$t" && exec "$hit" --help
	found suite && exec "$hit" "$@"
	[ $# -gt 1 ] || list
	[ $# -eq 2 ] && target "$@" || usage
	set -- "$t"
fi
case $1 in -*) ;; *) valid "$1" && found "$1" && shift && exec "$hit" "$@" ;; esac
found suite && exec "$hit" "$@"
case $1 in
--version) [ $# -eq 1 ] || usage; echo "agentik $VERSION (no suite installed)"; exit 0 ;;
-h | --help) [ $# -eq 1 ] || usage; list ;;
-*) usage ;;
esac
valid "$1" || refuse "$1"
missing "$1"
